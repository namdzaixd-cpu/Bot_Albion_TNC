# ==============================================================================
# FILE NÀY LÀ MẪU - SAO CHÉP THÀNH .env VÀ ĐIỀN GIÁ TRỊ THẬT VÀO
# KHÔNG BAO GIỜ COMMIT FILE .env LÊN GITHUB!
# ==============================================================================

# Token của Discord Bot (lấy từ Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# ID của Guild (server) Discord mà bot phục vụ
DISCORD_GUILD_ID=712258265769050164

# URL GitHub có kèm Personal Access Token (PAT) để tự động push dữ liệu
# Tạo PAT tại: GitHub → Settings → Developer settings → Personal access tokens
# Quyền cần thiết: repo (full control)
GITHUB_GIT_URL=https://ghp_YOUR_PAT_HERE@github.com/username/repo.git

# API Key cho Gemini (Google AI Studio)
GEMINI_API_KEY=AQ.Ab8RN6J_PUmpitfnqTp0MT_HL51ih2DaiXr0hhrpt-Z_Oivasw
